{
  "name": "resumefy-scripts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate-link": "node -r dotenv/config generate-magic-link.js",
    "winback-campaign": "node -r dotenv/config bulk-winback-campaign.js",
    "winback-dry-run": "node -r dotenv/config bulk-winback-campaign.js --dry-run",
    "winback-test": "node -r dotenv/config bulk-winback-campaign.js --dry-run",
    "check-users": "node -r dotenv/config check-users.js",
    "check-user": "node -r dotenv/config check-single-user.js",
